@page "/login"
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Nav

<PageTitle>Anmelden – Druckkammer</PageTitle>

<MudGrid Justify="Justify.Center" Class="mt-6">
    <MudItem xs="12" sm="8" md="5">
        <MudPaper Elevation="4" Class="pa-6" Style="border-radius: 16px;">
            <div class="d-flex flex-column align-center mb-4">
                <img src="/logo.png" alt="Druckkammer Logo" style="width: 84px; height: 84px; border-radius: 18px; box-shadow: 0 4px 20px rgba(0,0,0,0.4);" />
                <MudText Typo="Typo.h5" Style="font-weight: 800;" Class="mt-3">DRUCKKAMMER</MudText>
                <MudText Typo="Typo.body2" Style="opacity: 0.75;">STL-Bibliothek &amp; Tabletop-Druckjobverwaltung</MudText>
            </div>

            @if (_error == "invalid")
            {
                <MudAlert Severity="Severity.Error" Class="mb-3" Dense="true">E-Mail oder Passwort ungültig.</MudAlert>
            }
            else if (_error == "unapproved")
            {
                <MudAlert Severity="Severity.Warning" Class="mb-3" Dense="true">Dein Account wartet noch auf die Freischaltung durch den Administrator.</MudAlert>
            }
            @if (_info == "pending_approval")
            {
                <MudAlert Severity="Severity.Info" Class="mb-3" Dense="true">Registrierung erfolgreich! Sobald der Admin deinen Account freischaltet, kannst du dich anmelden.</MudAlert>
            }

            <form method="post" action="/auth/login">
                <MudTextField T="string" Label="E-Mail-Adresse" InputType="InputType.Email" Variant="Variant.Outlined" Margin="Margin.Dense"
                              UserAttributes="@(new Dictionary<string, object> { ["name"] = "email" })"
                              Required="true" Class="mb-3" />
                <MudTextField T="string" Label="Passwort" InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense"
                              UserAttributes="@(new Dictionary<string, object> { ["name"] = "password" })"
                              Required="true" Class="mb-4" />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.Login">
                    Anmelden
                </MudButton>
            </form>

            <div class="text-center mt-4">
                <MudLink Href="/register" Typo="Typo.body2">Neu hier? Mit Einladungs-Code oder zur Freischaltung registrieren →</MudLink>
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private string? _error;
    private string? _info;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        if (!await db.Users.AnyAsync())
        {
            Nav.NavigateTo("/setup", replace: true);
            return;
        }

        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("error", out var err)) _error = err.ToString();
        if (query.TryGetValue("info", out var inf)) _info = inf.ToString();
    }
}
