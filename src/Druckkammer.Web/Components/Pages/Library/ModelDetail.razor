@page "/library/{Id:int}"
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject ManagedStorageService StorageService
@inject UserContextService UserContext
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>@(_model?.Title ?? "Modell-Details") – Druckkammer</PageTitle>

@if (_model is null)
{
    <MudAlert Severity="Severity.Warning">Modell nicht gefunden.</MudAlert>
}
else
{
    <div class="d-flex flex-wrap justify-space-between align-center gap-2 mb-4">
        <div class="d-flex align-center gap-2">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="/library" />
            <div>
                <div class="d-flex align-center gap-2">
                    <MudText Typo="Typo.h4" Style="font-weight: 800;">@_model.Title</MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary">@LibraryCatalog.GetScaleBadgeText(_model.ScaleSize)</MudChip>
                    <MudChip T="string" Size="Size.Small" Color="@LibraryCatalog.GetPrintabilityColor(_model.Printability)">
                        @LibraryCatalog.GetPrintabilityLabel(_model.Printability)
                    </MudChip>
                </div>
                <MudText Typo="Typo.body2" Style="opacity: 0.75;">
                    Studio: <strong>@_model.CreatorStudio</strong>
                    @(!string.IsNullOrWhiteSpace(_model.ReleaseMonth) ? $" · Release: {_model.ReleaseMonth}" : "")
                    · 🏆 Bereits <strong>@(_model.PrintCount)x</strong> erfolgreich gedruckt
                </MudText>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2">
            @if (_currentUser.HasPermission(AppPermissions.LibraryManageModels))
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Edit"
                           OnClick="@(() => _showCuratorEditor = !_showCuratorEditor)">
                    @(_showCuratorEditor ? "Editor schließen" : "Modell & Zuordnung bearbeiten")
                </MudButton>
            }
            @if (!string.IsNullOrWhiteSpace(_model.ExternalSourceUrl))
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.OpenInNew"
                           Href="@_model.ExternalSourceUrl" Target="_blank">
                    Original-Quelle
                </MudButton>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                       StartIcon="@Icons.Material.Filled.AddShoppingCart"
                       OnClick="OpenPrintRequestDialogAsync">
                Als Druckwunsch / in Session-Warenkorb
            </MudButton>
        </div>
    </div>

    <!-- Kuratoren-Editor (Metadaten, Collections, Tags & Löschen) -->
    @if (_showCuratorEditor && _currentUser.HasPermission(AppPermissions.LibraryManageModels))
    {
        <MudPaper Elevation="3" Class="pa-4 mb-4" Style="border-left: 4px solid #26A69A;">
            <div class="d-flex justify-space-between align-center mb-3">
                <MudText Typo="Typo.h6" Style="font-weight: 700;">✏️ Kuratoren-Editor: Modell, Collections &amp; Tags bearbeiten</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.DeleteForever"
                           OnClick="DeleteEntireModelAsync">
                    Modell löschen
                </MudButton>
            </div>

            <MudGrid Spacing="2">
                <MudItem xs="12" sm="5">
                    <MudTextField @bind-Value="_editTitle" Label="Modellname" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudTextField @bind-Value="_editStudio" Label="Creator / Studio" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="2">
                    <MudTextField @bind-Value="_editRelease" Label="Release (z.B. 2026-10)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="2">
                    <MudSelect T="TabletopScaleSize" @bind-Value="_editScaleSize" Label="Kreaturengröße" Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem Value="TabletopScaleSize.Tiny">Tiny (&lt;20mm)</MudSelectItem>
                        <MudSelectItem Value="TabletopScaleSize.SmallMedium">32mm Medium</MudSelectItem>
                        <MudSelectItem Value="TabletopScaleSize.Large">50mm Large</MudSelectItem>
                        <MudSelectItem Value="TabletopScaleSize.Huge">75mm Huge</MudSelectItem>
                        <MudSelectItem Value="TabletopScaleSize.Gargantuan">100mm+ Boss</MudSelectItem>
                        <MudSelectItem Value="TabletopScaleSize.TerrainScenery">Terrain</MudSelectItem>
                        <MudSelectItem Value="TabletopScaleSize.BustDisplay">75mm Büste</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect T="int" MultiSelection="true" @bind-SelectedValues="_editCollectionIds"
                               Label="Zugeordnete Collections" Variant="Variant.Outlined" Margin="Margin.Dense"
                               ToStringFunc="@(id => _allCollections.FirstOrDefault(c => c.Id == id)?.Name ?? id.ToString())">
                        @foreach (var c in _allCollections)
                        {
                            <MudSelectItem T="int" Value="@c.Id">@c.CreatorStudio — @c.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect T="int" MultiSelection="true" @bind-SelectedValues="_editTagIds"
                               Label="Zugeordnete Tags" Variant="Variant.Outlined" Margin="Margin.Dense"
                               ToStringFunc="@(id => _allTags.FirstOrDefault(t => t.Id == id)?.Name ?? id.ToString())">
                        @foreach (var t in _allTags)
                        {
                            <MudSelectItem T="int" Value="@t.Id">#@t.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="9">
                    <MudTextField @bind-Value="_editDescription" Label="Beschreibung" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="3" Class="d-flex justify-end align-center gap-2">
                    <MudButton Variant="Variant.Text" OnClick="@(() => _showCuratorEditor = false)">Abbrechen</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Save"
                               OnClick="SaveCuratorMetadataAsync">
                        Änderungen speichern
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>
    }

    <MudGrid Spacing="3">
        <!-- Linke Spalte: Interaktiver 3D-Viewer & Dateien / Slicer-Tresor -->
        <MudItem xs="12" md="7">
            <Model3DViewer ModelItemId="_model.Id"
                           Files="_model.Files"
                           CurrentThumbnailPath="_model.ThumbnailPath"
                           HeightPx="400"
                           OnThumbnailUpdated="OnThumbnailUpdated" />

            <!-- Enthaltene Druckdateien & Slicer-Tresor -->
            <MudPaper Elevation="2" Class="pa-4 mt-4">
                <div class="d-flex flex-wrap justify-space-between align-center gap-2 mb-3">
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.FolderOpen" Color="Color.Primary" />
                        <MudText Typo="Typo.h6" Style="font-weight: 700;">
                            Enthaltene Dateien &amp; Slicer-Tresor (@_model.Files.Count)
                        </MudText>
                    </div>

                    @if (_currentUser.HasPermission(AppPermissions.LibraryUploadModels) || _currentUser.HasPermission(AppPermissions.QueueManageBatches))
                    {
                        <MudFileUpload T="IBrowserFile" FilesChanged="OnAdditionalFileUploadedAsync"
                                       Accept=".stl,.obj,.3mf,.lys,.lyt,.chitubox,.ctb,.goo,.gcode,.png,.jpg">
                            <CustomContent Context="fileUpload">
                                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.UploadFile"
                                           OnClick="@fileUpload.OpenFilePickerAsync">
                                    Slicer-Datei (.lys/.ctb) oder Variante hinzufügen
                                </MudButton>
                            </CustomContent>
                        </MudFileUpload>
                    }
                </div>

                <MudSimpleTable Dense="true" Hover="true" Striped="true">
                    <thead>
                        <tr>
                            <th>Variante / Datei</th>
                            <th>Typ</th>
                            <th>Volumen / Maße</th>
                            <th>SHA-256</th>
                            <th style="text-align: right;">Aktion</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in _model.Files.OrderBy(x => x.Category))
                        {
                            <tr>
                                <td>
                                    <MudText Typo="Typo.body2" Style="font-weight: 600;">@f.VariantLabel</MudText>
                                    <MudText Typo="Typo.caption" Style="opacity: 0.7;">@f.FileName (@((f.FileSizeBytes / 1024.0).ToString("F0")) KB)</MudText>
                                </td>
                                <td>
                                    <MudChip T="string" Size="Size.Small" Color="@GetCategoryColor(f.Category)" Variant="Variant.Outlined">
                                        @f.Category
                                    </MudChip>
                                </td>
                                <td>
                                    @if (f.VolumeCm3 > 0)
                                    {
                                        <MudText Typo="Typo.body2">💧 @f.VolumeCm3.ToString("F1") ml</MudText>
                                        <MudText Typo="Typo.caption">@f.DimXMm.ToString("F0")×@f.DimYMm.ToString("F0")×@f.DimZMm.ToString("F0") mm</MudText>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.caption" Style="opacity: 0.6;">—</MudText>
                                    }
                                </td>
                                <td>
                                    <MudTooltip Text="@($"SHA-256: {f.Sha256Hash}")">
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text">
                                            #@f.Sha256Hash[..Math.Min(8, f.Sha256Hash.Length)]
                                        </MudChip>
                                    </MudTooltip>
                                </td>
                                <td style="text-align: right;">
                                    <MudIconButton Icon="@Icons.Material.Filled.Download" Color="Color.Primary" Size="Size.Small"
                                                   Href="@($"/api/files/{f.Id}/download")" Target="_blank" />
                                    @if (_currentUser.HasPermission(AppPermissions.LibraryManageModels) && _model.Files.Count > 1)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small"
                                                       OnClick="@(() => DeleteModelFileAsync(f.Id))" />
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
        </MudItem>

        <!-- Rechte Spalte: Printability-Ampel, Collections/Tags & Makes/Bemal-Galerie -->
        <MudItem xs="12" md="5">
            <!-- Printability-Ampel & Erfahrungsnotizen -->
            <MudPaper Elevation="2" Class="pa-4 mb-4">
                <div class="d-flex align-center gap-2 mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.Traffic" Color="Color.Warning" />
                    <MudText Typo="Typo.h6" Style="font-weight: 700;">Printability-Ampel &amp; Druck-Erfahrung</MudText>
                </div>

                @if (!string.IsNullOrWhiteSpace(_model.Description))
                {
                    <MudText Typo="Typo.body2" Class="mb-3" Style="opacity: 0.85;">@_model.Description</MudText>
                }

                <MudSelect T="PrintabilityStatus" @bind-Value="_editPrintability" Label="Druckbarkeits-Bewertung (Presupports & Details)"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2">
                    <MudSelectItem Value="PrintabilityStatus.Untested">⚪ Ungetestet</MudSelectItem>
                    <MudSelectItem Value="PrintabilityStatus.GreenGood">🟢 Grün – Presupports top, druckt perfekt out-of-the-box</MudSelectItem>
                    <MudSelectItem Value="PrintabilityStatus.YellowCaution">🟡 Gelb – Vorsicht bei dünnen Details / leichte Nacharbeit</MudSelectItem>
                    <MudSelectItem Value="PrintabilityStatus.RedNeedsWork">🔴 Rot – Supports fehlerhaft, manuell in Lychee stützen!</MudSelectItem>
                </MudSelect>

                <MudTextField @bind-Value="_editPrintabilityNotes" Label="Technische Erfahrungsnotizen für zukünftige Drucke"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3"
                              Placeholder="z.B. 'Auf Saturn 4 mit 2.0s gedruckt. Am Schwert 2 zusätzliche Mini-Supports setzen!'" />

                <div class="d-flex justify-end mt-2">
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Save" OnClick="SavePrintabilityAsync">
                        Erfahrung speichern
                    </MudButton>
                </div>
            </MudPaper>

            <!-- Collections & Tags Zuordnung + Schnell-Tag-Erstellung -->
            <MudPaper Elevation="2" Class="pa-4 mb-4">
                <MudText Typo="Typo.subtitle1" Style="font-weight: 700;" Class="mb-2">Collections &amp; Tags</MudText>
                <div class="mb-3">
                    <MudText Typo="Typo.caption" Style="opacity: 0.7;">Enthalten in Collections:</MudText>
                    <div class="d-flex flex-wrap gap-1 mt-1">
                        @foreach (var mc in _model.Collections)
                        {
                            if (mc.Collection is not null)
                            {
                                <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined" Size="Size.Small"
                                         Href="@($"/collections/{mc.CollectionId}")">
                                    📁 @mc.Collection.Name
                                </MudChip>
                            }
                        }
                    </div>
                </div>

                <div>
                    <MudText Typo="Typo.caption" Style="opacity: 0.7;">Tags:</MudText>
                    <div class="d-flex flex-wrap gap-1 mt-1">
                        @foreach (var mt in _model.Tags)
                        {
                            if (mt.Tag is not null)
                            {
                                <MudChip T="string" Color="Color.Primary" Variant="Variant.Text" Size="Size.Small">#@mt.Tag.Name</MudChip>
                            }
                        }
                    </div>
                </div>

                @if (_currentUser.HasPermission(AppPermissions.LibraryManageModels))
                {
                    <div class="d-flex gap-2 align-center mt-3 pt-2" style="border-top: 1px solid rgba(255,255,255,0.08);">
                        <MudTextField @bind-Value="_quickNewTagName" Placeholder="Neuen Tag hinzufügen (z.B. Drache)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="CreateAndAttachQuickTagAsync">
                            + Tag
                        </MudButton>
                    </div>
                }
            </MudPaper>

            <!-- Makes & Bemal-Galerie am Modell -->
            <MudPaper Elevation="2" Class="pa-4">
                <div class="d-flex justify-space-between align-center mb-3">
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.PhotoCamera" Color="Color.Info" />
                        <MudText Typo="Typo.h6" Style="font-weight: 700;">Makes &amp; Bemal-Galerie (@_model.Makes.Count)</MudText>
                    </div>
                </div>

                @if (_model.Makes.Count == 0)
                {
                    <MudAlert Severity="Severity.Normal" Dense="true" Class="mb-3">
                        Noch kein Foto hochgeladen – teile dein erstes gedrucktes oder bemaltes Ergebnis!
                    </MudAlert>
                }
                else
                {
                    <MudGrid Spacing="2" Class="mb-3">
                        @foreach (var make in _model.Makes.OrderByDescending(m => m.CreatedAt))
                        {
                            <MudItem xs="12" sm="6">
                                <MudPaper Outlined="true" Class="pa-2">
                                    <img src="@($"/media/{make.ImagePath}")" alt="@make.Caption"
                                         style="width: 100%; height: 130px; object-fit: cover; border-radius: 6px;" />
                                    <div class="d-flex justify-space-between align-center mt-1">
                                        <MudText Typo="Typo.caption" Style="font-weight: 700;">@make.UserDisplayName</MudText>
                                        <MudChip T="string" Size="Size.Small" Color="@(make.IsPainted ? Color.Success : Color.Info)">
                                            @(make.IsPainted ? "🎨 Bemalt" : "🖨️ Gedruckt")
                                        </MudChip>
                                    </div>
                                    <MudText Typo="Typo.caption" Style="opacity: 0.8;">@make.Caption</MudText>
                                </MudPaper>
                            </MudItem>
                        }
                    </MudGrid>
                }

                <!-- Make Foto hochladen -->
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.subtitle2" Class="mb-2">Eigenes Make- oder Bemal-Foto teilen:</MudText>
                <MudTextField @bind-Value="_newMakeCaption" Label="Kommentar (z.B. 'Mit Vallejo Farben bemalt')" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
                <div class="d-flex justify-space-between align-center">
                    <MudCheckBox T="bool" @bind-Value="_newMakeIsPainted" Label="🎨 Figur ist bereits fertig bemalt" Color="Color.Success" Dense="true" />
                    <MudFileUpload T="IBrowserFile" FilesChanged="UploadMakePhotoAsync" Accept=".png,.jpg,.jpeg,.webp">
                        <CustomContent Context="fileUpload">
                            <MudButton Variant="Variant.Filled" Color="Color.Info" Size="Size.Small" StartIcon="@Icons.Material.Filled.AddAPhoto"
                                       OnClick="@fileUpload.OpenFilePickerAsync">
                                Foto hochladen
                            </MudButton>
                        </CustomContent>
                    </MudFileUpload>
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public int Id { get; set; }

    private CurrentUserInfo _currentUser = new(false, "", "", "Gast", "#78909C", false, [], []);
    private ModelItem? _model;
    private List<Collection> _allCollections = [];
    private List<Tag> _allTags = [];

    private bool _showCuratorEditor;
    private string _editTitle = string.Empty;
    private string _editStudio = string.Empty;
    private string _editRelease = string.Empty;
    private string _editDescription = string.Empty;
    private TabletopScaleSize _editScaleSize;
    private IReadOnlyCollection<int> _editCollectionIds = [];
    private IReadOnlyCollection<int> _editTagIds = [];
    private string _quickNewTagName = string.Empty;

    private PrintabilityStatus _editPrintability;
    private string _editPrintabilityNotes = string.Empty;

    private string _newMakeCaption = string.Empty;
    private bool _newMakeIsPainted = true;

    protected override async Task OnParametersSetAsync()
    {
        _currentUser = await UserContext.GetCurrentUserAsync();
        await LoadModelAsync();
    }

    private async Task LoadModelAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _model = await db.ModelItems
            .Include(m => m.Files)
            .Include(m => m.Collections).ThenInclude(mc => mc.Collection)
            .Include(m => m.Tags).ThenInclude(mt => mt.Tag)
            .Include(m => m.Makes)
            .AsSplitQuery()
            .AsNoTracking()
            .FirstOrDefaultAsync(m => m.Id == Id);

        _allCollections = await db.Collections.OrderBy(c => c.CreatorStudio).ThenBy(c => c.Name).AsNoTracking().ToListAsync();
        _allTags = await db.Tags.OrderBy(t => t.Name).AsNoTracking().ToListAsync();

        if (_model is not null)
        {
            _editTitle = _model.Title;
            _editStudio = _model.CreatorStudio;
            _editRelease = _model.ReleaseMonth;
            _editDescription = _model.Description;
            _editScaleSize = _model.ScaleSize;
            _editCollectionIds = _model.Collections.Select(c => c.CollectionId).ToList();
            _editTagIds = _model.Tags.Select(t => t.TagId).ToList();

            _editPrintability = _model.Printability;
            _editPrintabilityNotes = _model.PrintabilityNotes;
        }
    }

    private void OnThumbnailUpdated(string newRelPath)
    {
        if (_model is not null)
            _model.ThumbnailPath = newRelPath;
    }

    private async Task SaveCuratorMetadataAsync()
    {
        if (_model is null || string.IsNullOrWhiteSpace(_editTitle)) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.ModelItems
            .Include(m => m.Collections)
            .Include(m => m.Tags)
            .FirstOrDefaultAsync(m => m.Id == _model.Id);

        if (entity is null) return;

        entity.Title = _editTitle.Trim();
        entity.Slug = ManagedStorageService.Slugify(_editTitle);
        entity.CreatorStudio = _editStudio.Trim();
        entity.ReleaseMonth = _editRelease.Trim();
        entity.Description = _editDescription.Trim();
        entity.ScaleSize = _editScaleSize;
        entity.UpdatedAt = DateTime.UtcNow;

        entity.Collections.Clear();
        foreach (var cid in _editCollectionIds.Distinct())
        {
            entity.Collections.Add(new ModelCollectionMap { ModelItemId = entity.Id, CollectionId = cid });
        }

        entity.Tags.Clear();
        foreach (var tid in _editTagIds.Distinct())
        {
            entity.Tags.Add(new ModelTagMap { ModelItemId = entity.Id, TagId = tid });
        }

        await db.SaveChangesAsync();
        _showCuratorEditor = false;
        await LoadModelAsync();
        Snackbar.Add("Modell-Metadaten, Collections und Tags aktualisiert!", Severity.Success);
    }

    private async Task CreateAndAttachQuickTagAsync()
    {
        if (_model is null || string.IsNullOrWhiteSpace(_quickNewTagName)) return;
        string cleanTag = _quickNewTagName.Trim().TrimStart('#');
        if (string.IsNullOrWhiteSpace(cleanTag)) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var tag = await db.Tags.FirstOrDefaultAsync(t => t.Name.ToLower() == cleanTag.ToLower());
        if (tag is null)
        {
            tag = new Tag { Name = cleanTag, ColorHex = "#26A69A" };
            db.Tags.Add(tag);
            await db.SaveChangesAsync();
        }

        if (!await db.ModelTagMaps.AnyAsync(mt => mt.ModelItemId == _model.Id && mt.TagId == tag.Id))
        {
            db.ModelTagMaps.Add(new ModelTagMap { ModelItemId = _model.Id, TagId = tag.Id });
            await db.SaveChangesAsync();
        }

        _quickNewTagName = string.Empty;
        await LoadModelAsync();
        Snackbar.Add($"Tag '#{tag.Name}' verknüpft!", Severity.Success);
    }

    private async Task DeleteModelFileAsync(int fileId)
    {
        if (_model is null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var file = await db.ModelFiles.FindAsync(fileId);
        if (file is not null)
        {
            db.ModelFiles.Remove(file);
            await db.SaveChangesAsync();
            await LoadModelAsync();
            Snackbar.Add($"Datei '{file.FileName}' entfernt.", Severity.Info);
        }
    }

    private async Task DeleteEntireModelAsync()
    {
        if (_model is null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.ModelItems.FindAsync(_model.Id);
        if (entity is not null)
        {
            db.ModelItems.Remove(entity);
            await db.SaveChangesAsync();
            Snackbar.Add($"Modell '{entity.Title}' gelöscht.", Severity.Warning);
            Nav.NavigateTo("/library");
        }
    }

    private async Task SavePrintabilityAsync()
    {
        if (_model is null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.ModelItems.FindAsync(_model.Id);
        if (entity is not null)
        {
            entity.Printability = _editPrintability;
            entity.PrintabilityNotes = _editPrintabilityNotes.Trim();
            entity.UpdatedAt = DateTime.UtcNow;
            await db.SaveChangesAsync();
            await LoadModelAsync();
            Snackbar.Add("Printability-Ampel & Erfahrungsnotizen gespeichert!", Severity.Success);
        }
    }

    private async Task OnAdditionalFileUploadedAsync(IBrowserFile? file)
    {
        if (file is null || _model is null) return;
        await using var stream = file.OpenReadStream(maxAllowedSize: 250 * 1024 * 1024);
        var stored = await StorageService.StoreModelFileStreamAsync(
            stream,
            file.Name,
            _model.CreatorStudio,
            _model.Collections.FirstOrDefault()?.Collection?.Name ?? "Allgemein",
            _model.Title);

        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.ModelItems.Include(m => m.Files).FirstOrDefaultAsync(m => m.Id == _model.Id);
        if (entity is not null)
        {
            ManagedStorageService.AttachStoredFileToModel(entity, file.Name, stored);
            ManagedStorageService.FinalizeModelMetrics(entity);
            await db.SaveChangesAsync();
            await LoadModelAsync();
            Snackbar.Add($"Datei '{file.Name}' zum Modell hinzugefügt!", Severity.Success);
        }
    }

    private async Task UploadMakePhotoAsync(IBrowserFile? photo)
    {
        if (photo is null || _model is null) return;
        await using var stream = photo.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024);
        string relPath = await StorageService.SaveMakeImageStreamAsync(stream, photo.Name);

        await using var db = await DbFactory.CreateDbContextAsync();
        db.ModelMakes.Add(new ModelMake
        {
            ModelItemId = _model.Id,
            UserId = _currentUser.UserId,
            UserDisplayName = _currentUser.DisplayName,
            ImagePath = relPath,
            Caption = string.IsNullOrWhiteSpace(_newMakeCaption) ? "Mein Druckergebnis" : _newMakeCaption.Trim(),
            IsPainted = _newMakeIsPainted,
            MaterialUsed = "Resin SLA"
        });
        await db.SaveChangesAsync();
        _newMakeCaption = string.Empty;
        await LoadModelAsync();
        Snackbar.Add("Make-Foto in der Galerie veröffentlicht!", Severity.Success);
    }

    private async Task OpenPrintRequestDialogAsync()
    {
        if (_model is null) return;
        var parameters = new DialogParameters<CreateRequestDialog> { { x => x.PreselectedModel, _model } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<CreateRequestDialog>("Druckwunsch anlegen", parameters, options);
    }

    private static Color GetCategoryColor(ModelFileCategory cat) => cat switch
    {
        ModelFileCategory.PresupportedMesh => Color.Success,
        ModelFileCategory.SlicerProject or ModelFileCategory.SlicedPlate => Color.Info,
        ModelFileCategory.BaseMesh => Color.Secondary,
        _ => Color.Default
    };
}
