@page "/library"
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject UserContextService UserContext
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>3D-Modell-Katalog – Druckkammer</PageTitle>

<div class="d-flex flex-wrap justify-space-between align-center gap-3 mb-4">
    <div>
        <MudText Typo="Typo.h4" Style="font-weight: 800;">3D-Modell-Katalog</MudText>
        <MudText Typo="Typo.body2" Style="opacity: 0.75;">
            Durchsuche eure STL-Sammlung nach Creator, D&D-Kreaturengröße, Tags oder Printability-Ampel.
        </MudText>
    </div>
    <div class="d-flex gap-2">
        @if (_currentUser.HasPermission(AppPermissions.LibraryManageModels))
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Label"
                       OnClick="@(() => _showTagManager = !_showTagManager)">
                Tags verwalten (@_tags.Count)
            </MudButton>
        }
        @if (_currentUser.HasPermission(AppPermissions.LibraryUploadModels))
        {
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.CloudUpload"
                       OnClick="OpenUploadModelDialogAsync">
                Modell / ZIP-Bundle hochladen
            </MudButton>
        }
    </div>
</div>

@if (_showTagManager && _currentUser.HasPermission(AppPermissions.LibraryManageModels))
{
    <MudPaper Elevation="3" Class="pa-4 mb-4" Style="border-left: 4px solid #9575CD;">
        <MudText Typo="Typo.subtitle1" Style="font-weight: 700;" Class="mb-2">🏷️ Tag-Manager: Neue Tags anlegen oder entfernen</MudText>
        <div class="d-flex flex-wrap gap-2 align-center mb-3">
            <MudTextField @bind-Value="_newTagName" Label="Neuer Tag-Name (z.B. Drache, Sci-Fi, Base)" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 280px;" />
            <MudTextField @bind-Value="_newTagColor" Label="Farbe (Hex)" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 140px;" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateTagAsync">Tag erstellen</MudButton>
        </div>
        <div class="d-flex flex-wrap gap-1">
            @foreach (var t in _tags)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" OnClose="@(() => DeleteTagAsync(t.Id))">
                    #@t.Name
                </MudChip>
            }
        </div>
    </MudPaper>
}

<!-- Such- und Filterleiste -->
<MudPaper Elevation="2" Class="pa-4 mb-4">
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="4">
            <MudTextField @bind-Value="_searchText" Label="Modell, Studio oder Dateiname suchen..." Variant="Variant.Outlined" Margin="Margin.Dense"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Clearable="true" />
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudSelect T="string" @bind-Value="_selectedStudio" Label="Creator / Studio" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                @foreach (var s in _studios)
                {
                    <MudSelectItem Value="@s">@s</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudSelect T="int?" @bind-Value="_selectedCollectionId" Label="Collection / Release-Bundle" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                @foreach (var c in _collections)
                {
                    <MudSelectItem T="int?" Value="@c.Id">@c.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudSelect T="TabletopScaleSize?" @bind-Value="_selectedScaleSize" Label="D&D Kreaturengröße" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                <MudSelectItem T="TabletopScaleSize?" Value="TabletopScaleSize.Tiny">Tiny (&lt;20mm)</MudSelectItem>
                <MudSelectItem T="TabletopScaleSize?" Value="TabletopScaleSize.SmallMedium">Small/Medium (32mm)</MudSelectItem>
                <MudSelectItem T="TabletopScaleSize?" Value="TabletopScaleSize.Large">Large (50mm)</MudSelectItem>
                <MudSelectItem T="TabletopScaleSize?" Value="TabletopScaleSize.Huge">Huge (75mm)</MudSelectItem>
                <MudSelectItem T="TabletopScaleSize?" Value="TabletopScaleSize.Gargantuan">Gargantuan (100mm+)</MudSelectItem>
                <MudSelectItem T="TabletopScaleSize?" Value="TabletopScaleSize.TerrainScenery">Terrain / Scenery</MudSelectItem>
                <MudSelectItem T="TabletopScaleSize?" Value="TabletopScaleSize.BustDisplay">Büste / Display</MudSelectItem>
            </MudSelect>
        </MudItem>
    </MudGrid>

    <!-- Smart-Filter & Tags -->
    <div class="d-flex flex-wrap align-center justify-space-between gap-2 mt-3 pt-2" style="border-top: 1px solid rgba(255,255,255,0.08);">
        <div class="d-flex flex-wrap align-center gap-1">
            <MudText Typo="Typo.caption" Class="mr-1" Style="opacity: 0.7;">Smart-Filter:</MudText>
            <MudChip T="string" Size="Size.Small" Color="@(_filterPresupported ? Color.Secondary : Color.Default)"
                     Variant="@(_filterPresupported ? Variant.Filled : Variant.Outlined)"
                     OnClick="@(() => _filterPresupported = !_filterPresupported)">
                ✅ Hat Presupports
            </MudChip>
            <MudChip T="string" Size="Size.Small" Color="@(_filterSlicerProject ? Color.Info : Color.Default)"
                     Variant="@(_filterSlicerProject ? Variant.Filled : Variant.Outlined)"
                     OnClick="@(() => _filterSlicerProject = !_filterSlicerProject)">
                🗂️ Hat Slicer-Projekt (.lys/.ctb)
            </MudChip>
            <MudChip T="string" Size="Size.Small" Color="@(_filterAlreadyPrinted ? Color.Success : Color.Default)"
                     Variant="@(_filterAlreadyPrinted ? Variant.Filled : Variant.Outlined)"
                     OnClick="@(() => _filterAlreadyPrinted = !_filterAlreadyPrinted)">
                🏆 Schon gedruckt
            </MudChip>
            <MudChip T="string" Size="Size.Small" Color="@(_filterFavoritesOnly ? Color.Warning : Color.Default)"
                     Variant="@(_filterFavoritesOnly ? Variant.Filled : Variant.Outlined)"
                     OnClick="@(() => _filterFavoritesOnly = !_filterFavoritesOnly)">
                ⭐ Meine Favoriten
            </MudChip>
            <MudChip T="string" Size="Size.Small" Color="@(_filterMissingThumbnail ? Color.Error : Color.Default)"
                     Variant="@(_filterMissingThumbnail ? Variant.Filled : Variant.Outlined)"
                     OnClick="@(() => _filterMissingThumbnail = !_filterMissingThumbnail)">
                🖼️ Ohne Vorschaubild
            </MudChip>
        </div>

        <div class="d-flex flex-wrap align-center gap-1">
            <MudText Typo="Typo.caption" Class="mr-1" Style="opacity: 0.7;">Tags:</MudText>
            @foreach (var tag in _tags)
            {
                bool active = _selectedTagId == tag.Id;
                <MudChip T="string" Size="Size.Small" Variant="@(active ? Variant.Filled : Variant.Outlined)"
                         Color="@(active ? Color.Primary : Color.Default)"
                         OnClick="@(() => _selectedTagId = active ? null : tag.Id)">
                    #@tag.Name
                </MudChip>
            }
        </div>
    </div>
</MudPaper>

<!-- Ergebnis-Grid -->
@{
    var filtered = FilteredModels.ToList();
}

@if (filtered.Count == 0)
{
    <MudPaper Class="pa-8 text-center">
        <MudIcon Icon="@Icons.Material.Filled.SearchOff" Style="font-size: 3rem; opacity: 0.5;" />
        <MudText Typo="Typo.h6" Class="mt-2">Keine passenden 3D-Modelle gefunden</MudText>
        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="ResetFilters">Alle Filter zurücksetzen</MudButton>
    </MudPaper>
}
else
{
    <MudGrid Spacing="3">
        @foreach (var model in filtered)
        {
            bool isFav = _favoriteModelIds.Contains(model.Id);
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Elevation="3" Class="h-100 d-flex flex-column" Style="border-radius: 12px; overflow: hidden;">
                    <!-- Vorschaubild oder stilisierter 3D-Platzhalter -->
                    <div style="height: 190px; background: radial-gradient(circle, #282E40 0%, #161924 100%); position: relative; cursor: pointer;"
                         @onclick="@(() => Nav.NavigateTo($"/library/{model.Id}"))">
                        @if (!string.IsNullOrWhiteSpace(model.ThumbnailPath))
                        {
                            string imgSrc = model.ThumbnailPath.StartsWith("http") ? model.ThumbnailPath : $"/media/{model.ThumbnailPath}";
                            <img src="@imgSrc" alt="@model.Title" style="width: 100%; height: 100%; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="d-flex flex-column align-center justify-center h-100">
                                <MudIcon Icon="@Icons.Material.Filled.ViewInAr" Color="Color.Primary" Style="font-size: 3.8rem; opacity: 0.7;" />
                                <MudText Typo="Typo.caption" Style="opacity: 0.6;">Klicken für interaktive 3D-Ansicht</MudText>
                            </div>
                        }

                        <!-- Badges oben links: Kreaturengröße & Printability-Ampel -->
                        <div style="position: absolute; top: 8px; left: 8px; display: flex; gap: 4px; flex-wrap: wrap;">
                            <MudChip T="string" Size="Size.Small" Color="Color.Dark" Style="background: rgba(18,21,30,0.85); color: #ECEFF1;">
                                @GetScaleBadgeText(model.ScaleSize)
                            </MudChip>
                            @if (model.Printability != PrintabilityStatus.Untested)
                            {
                                <MudChip T="string" Size="Size.Small" Color="@GetPrintabilityColor(model.Printability)">
                                    @GetPrintabilityLabel(model.Printability)
                                </MudChip>
                            }
                        </div>

                        <!-- Favoriten-Stern oben rechts -->
                        <div style="position: absolute; top: 4px; right: 4px;" @onclick:stopPropagation="true">
                            <MudIconButton Icon="@(isFav ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)"
                                           Color="@(isFav ? Color.Warning : Color.Default)" Size="Size.Small"
                                           OnClick="@(() => ToggleFavoriteAsync(model.Id))" />
                        </div>

                        <!-- Unten rechts: Volumen & Höhe -->
                        <div style="position: absolute; bottom: 6px; right: 8px; background: rgba(18,21,30,0.85); padding: 2px 8px; border-radius: 6px; font-size: 0.75rem;">
                            💧 @model.EstimatedVolumeCm3.ToString("F1") ml · 📏 @model.BoundingBoxZMm.ToString("F0") mm
                        </div>
                    </div>

                    <MudCardContent Class="flex-grow-1 pb-1">
                        <div class="d-flex justify-space-between align-center mb-1">
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight: 700;">
                                @model.CreatorStudio @(!string.IsNullOrWhiteSpace(model.ReleaseMonth) ? $"({model.ReleaseMonth})" : "")
                            </MudText>
                            @if (model.PrintCount > 0)
                            {
                                <MudText Typo="Typo.caption" Style="color: #66BB6A;">🏆 @(model.PrintCount)x</MudText>
                            }
                        </div>

                        <MudText Typo="Typo.subtitle1" Style="font-weight: 700; line-height: 1.25; cursor: pointer;"
                                 @onclick="@(() => Nav.NavigateTo($"/library/{model.Id}"))">
                            @model.Title
                        </MudText>

                        <div class="d-flex flex-wrap gap-1 mt-2">
                            @if (model.HasPresupports)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Text" Style="height: 20px; font-size: 0.7rem;">Presupported</MudChip>
                            }
                            @foreach (var tm in model.Tags.Take(3))
                            {
                                if (tm.Tag is not null)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="height: 20px; font-size: 0.7rem;">#@tm.Tag.Name</MudChip>
                                }
                            }
                        </div>
                    </MudCardContent>

                    <MudCardActions Class="d-flex justify-space-between px-3 pb-3 pt-1">
                        <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.ViewInAr"
                                   Href="@($"/library/{model.Id}")">
                            3D & Details (@model.Files.Count)
                        </MudButton>

                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.AddShoppingCart"
                                   OnClick="@(() => OpenRequestForModelAsync(model))">
                            Wünschen
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private CurrentUserInfo _currentUser = new(false, "", "", "Gast", "#78909C", false, [], []);
    private List<ModelItem> _models = [];
    private List<Collection> _collections = [];
    private List<Tag> _tags = [];
    private List<string> _studios = [];
    private HashSet<int> _favoriteModelIds = [];

    private string _searchText = string.Empty;
    private string? _selectedStudio;
    private int? _selectedCollectionId;
    private TabletopScaleSize? _selectedScaleSize;
    private int? _selectedTagId;

    private bool _filterPresupported;
    private bool _filterSlicerProject;
    private bool _filterAlreadyPrinted;
    private bool _filterFavoritesOnly;
    private bool _filterMissingThumbnail;

    private bool _showTagManager;
    private string _newTagName = string.Empty;
    private string _newTagColor = "#26A69A";

    private async Task CreateTagAsync()
    {
        if (string.IsNullOrWhiteSpace(_newTagName)) return;
        string clean = _newTagName.Trim().TrimStart('#');
        await using var db = await DbFactory.CreateDbContextAsync();
        if (!await db.Tags.AnyAsync(t => t.Name.ToLower() == clean.ToLower()))
        {
            db.Tags.Add(new Tag { Name = clean, ColorHex = string.IsNullOrWhiteSpace(_newTagColor) ? "#26A69A" : _newTagColor.Trim() });
            await db.SaveChangesAsync();
            _newTagName = string.Empty;
            await LoadCatalogAsync();
            Snackbar.Add($"Tag '#{clean}' erstellt!", Severity.Success);
        }
    }

    private async Task DeleteTagAsync(int tagId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var tag = await db.Tags.FindAsync(tagId);
        if (tag is not null)
        {
            db.Tags.Remove(tag);
            await db.SaveChangesAsync();
            if (_selectedTagId == tagId) _selectedTagId = null;
            await LoadCatalogAsync();
            Snackbar.Add($"Tag '#{tag.Name}' gelöscht.", Severity.Info);
        }
    }

    private IEnumerable<ModelItem> FilteredModels => _models.Where(m =>
    {
        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            var q = _searchText.Trim();
            bool matchTitle = m.Title.Contains(q, StringComparison.OrdinalIgnoreCase);
            bool matchStudio = m.CreatorStudio.Contains(q, StringComparison.OrdinalIgnoreCase);
            bool matchDesc = m.Description.Contains(q, StringComparison.OrdinalIgnoreCase);
            bool matchFile = m.Files.Any(f => f.FileName.Contains(q, StringComparison.OrdinalIgnoreCase));
            if (!matchTitle && !matchStudio && !matchDesc && !matchFile)
                return false;
        }
        if (!string.IsNullOrWhiteSpace(_selectedStudio) && !string.Equals(m.CreatorStudio, _selectedStudio, StringComparison.OrdinalIgnoreCase))
            return false;
        if (_selectedCollectionId.HasValue && !m.Collections.Any(c => c.CollectionId == _selectedCollectionId.Value))
            return false;
        if (_selectedScaleSize.HasValue && m.ScaleSize != _selectedScaleSize.Value)
            return false;
        if (_selectedTagId.HasValue && !m.Tags.Any(t => t.TagId == _selectedTagId.Value))
            return false;
        if (_filterPresupported && !m.HasPresupports)
            return false;
        if (_filterSlicerProject && !m.HasSlicerProject)
            return false;
        if (_filterAlreadyPrinted && m.PrintCount <= 0)
            return false;
        if (_filterFavoritesOnly && !_favoriteModelIds.Contains(m.Id))
            return false;
        if (_filterMissingThumbnail && !string.IsNullOrWhiteSpace(m.ThumbnailPath))
            return false;

        return true;
    });

    protected override async Task OnInitializedAsync()
    {
        _currentUser = await UserContext.GetCurrentUserAsync();
        await LoadCatalogAsync();
    }

    private async Task LoadCatalogAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _models = await db.ModelItems
            .Include(m => m.Files)
            .Include(m => m.Collections)
            .Include(m => m.Tags).ThenInclude(mt => mt.Tag)
            .OrderByDescending(m => m.CreatedAt)
            .AsNoTracking()
            .ToListAsync();

        _collections = await db.Collections.OrderBy(c => c.Name).AsNoTracking().ToListAsync();
        _tags = await db.Tags.OrderBy(t => t.Name).AsNoTracking().ToListAsync();
        _studios = _models.Select(m => m.CreatorStudio).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct().OrderBy(s => s).ToList();

        if (_currentUser.IsAuthenticated)
        {
            var favs = await db.UserFavoriteModels
                .Where(f => f.UserId == _currentUser.UserId)
                .Select(f => f.ModelItemId)
                .ToListAsync();
            _favoriteModelIds = favs.ToHashSet();
        }
    }

    private void ResetFilters()
    {
        _searchText = string.Empty;
        _selectedStudio = null;
        _selectedCollectionId = null;
        _selectedScaleSize = null;
        _selectedTagId = null;
        _filterPresupported = false;
        _filterSlicerProject = false;
        _filterAlreadyPrinted = false;
        _filterFavoritesOnly = false;
        _filterMissingThumbnail = false;
    }

    private async Task ToggleFavoriteAsync(int modelId)
    {
        if (!_currentUser.IsAuthenticated) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var existing = await db.UserFavoriteModels.FindAsync(_currentUser.UserId, modelId);
        if (existing is not null)
        {
            db.UserFavoriteModels.Remove(existing);
            _favoriteModelIds.Remove(modelId);
        }
        else
        {
            db.UserFavoriteModels.Add(new UserFavoriteModel { UserId = _currentUser.UserId, ModelItemId = modelId });
            _favoriteModelIds.Add(modelId);
        }
        await db.SaveChangesAsync();
    }

    private async Task OpenUploadModelDialogAsync()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<UploadModelDialog>("Modell hochladen", options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadCatalogAsync();
        }
    }

    private async Task OpenRequestForModelAsync(ModelItem model)
    {
        var parameters = new DialogParameters<CreateRequestDialog> { { x => x.PreselectedModel, model } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<CreateRequestDialog>("Druckwunsch anlegen", parameters, options);
    }

    public static string GetScaleBadgeText(TabletopScaleSize size) => size switch
    {
        TabletopScaleSize.Tiny => "Tiny (<20mm)",
        TabletopScaleSize.SmallMedium => "32mm Medium",
        TabletopScaleSize.Large => "50mm Large",
        TabletopScaleSize.Huge => "75mm Huge",
        TabletopScaleSize.Gargantuan => "100mm+ Boss",
        TabletopScaleSize.TerrainScenery => "Terrain",
        TabletopScaleSize.BustDisplay => "75mm Büste",
        _ => "Standard"
    };

    public static Color GetPrintabilityColor(PrintabilityStatus status) => status switch
    {
        PrintabilityStatus.GreenGood => Color.Success,
        PrintabilityStatus.YellowCaution => Color.Warning,
        PrintabilityStatus.RedNeedsWork => Color.Error,
        _ => Color.Default
    };

    public static string GetPrintabilityLabel(PrintabilityStatus status) => status switch
    {
        PrintabilityStatus.GreenGood => "🟢 Supports Top",
        PrintabilityStatus.YellowCaution => "🟡 Vorsicht",
        PrintabilityStatus.RedNeedsWork => "🔴 Nachstützen!",
        _ => "Ungetestet"
    };
}
