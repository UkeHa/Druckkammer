@page "/makes"
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Nav

<PageTitle>Makes & Bemal-Galerie – Druckkammer</PageTitle>

<div class="d-flex flex-wrap justify-space-between align-center gap-3 mb-4">
    <div>
        <MudText Typo="Typo.h4" Style="font-weight: 800;">Makes & Bemal-Galerie</MudText>
        <MudText Typo="Typo.body2" Style="opacity: 0.75;">
            Fertig gedruckte und bemalte Figuren unserer Spielrunde – klicke auf ein Modell, um dein eigenes Foto hochzuladen.
        </MudText>
    </div>
    <div class="d-flex gap-2">
        <MudChip T="string" Color="@(!_paintedOnly ? Color.Primary : Color.Default)" OnClick="@(() => _paintedOnly = false)">Alle (@_makes.Count)</MudChip>
        <MudChip T="string" Color="@(_paintedOnly ? Color.Success : Color.Default)" OnClick="@(() => _paintedOnly = true)">🎨 Nur Bemalte (@_makes.Count(m => m.IsPainted))</MudChip>
    </div>
</div>

@if (_makes.Count == 0)
{
    <MudPaper Class="pa-8 text-center">
        <MudIcon Icon="@Icons.Material.Filled.PhotoLibrary" Style="font-size: 3.5rem; opacity: 0.5;" />
        <MudText Typo="Typo.h6" Class="mt-2">Noch keine Make-Fotos hochgeladen</MudText>
        <MudText Typo="Typo.body2" Class="mb-3" Style="opacity: 0.75;">Öffne ein Modell in der Bibliothek und lade rechts dein Foto hoch!</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/library">Zum Modell-Katalog</MudButton>
    </MudPaper>
}
else
{
    <MudGrid Spacing="3">
        @foreach (var make in _makes.Where(m => !_paintedOnly || m.IsPainted))
        {
            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="3">
                    <img src="@($"/media/{make.ImagePath}")" alt="@make.Caption" style="width: 100%; height: 220px; object-fit: cover;" />
                    <MudCardContent>
                        <div class="d-flex justify-space-between align-center mb-1">
                            <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">@make.UserDisplayName</MudText>
                            <MudChip T="string" Size="Size.Small" Color="@(make.IsPainted ? Color.Success : Color.Info)">
                                @(make.IsPainted ? "🎨 Bemalt" : "🖨️ Gedruckt")
                            </MudChip>
                        </div>
                        <MudText Typo="Typo.body2" Class="mb-2">@make.Caption</MudText>
                        @if (make.ModelItem is not null)
                        {
                            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                       OnClick="@(() => Nav.NavigateTo($"/library/{make.ModelItemId}"))">
                                → Modell: @make.ModelItem.Title
                            </MudButton>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private List<ModelMake> _makes = [];
    private bool _paintedOnly;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _makes = await db.ModelMakes
            .Include(m => m.ModelItem)
            .OrderByDescending(m => m.CreatedAt)
            .AsNoTracking()
            .ToListAsync();
    }
}
